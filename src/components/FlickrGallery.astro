---
const FLICKR_USER_ID = "114285742@N02";
const FLICKR_PROFILE_URL = `https://www.flickr.com/photos/${FLICKR_USER_ID}/`;
const FEED_URL = `https://www.flickr.com/services/feeds/photos_public.gne?id=${FLICKR_USER_ID}&format=json&nojsoncallback=1`;

interface FeedItem {
    title: string;
    link: string;
    media: { m: string };
}

let photos: FeedItem[] = [];

try {
    const res = await fetch(FEED_URL);
    if (res.ok) {
        const data = await res.json();
        photos = (data.items ?? []).slice(0, 6);
    }
} catch {
    photos = [];
}
---

<section id="photography" class="mb-12">
    <h2
        class="text-base font-semibold mb-4 pb-1 border-b border-b-color/15 flex items-baseline justify-between"
    >
        <span>Photography</span>
        <a
            href={FLICKR_PROFILE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-normal text-t-accent underline"
        >
            flickr &nearr;
        </a>
    </h2>

    {
        photos.length > 0 ? (
            <div class="grid grid-cols-3 gap-2">
                {photos.map((photo) => (
                    <a
                        href={photo.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={photo.title}
                        class="group block overflow-hidden rounded-md bg-b-color/10"
                    >
                        <img
                            src={photo.media.m.replace("_m.", "_q.")}
                            alt={photo.title || "Flickr photo"}
                            loading="lazy"
                            class="aspect-square w-full object-cover transition-transform duration-200 group-hover:scale-105"
                        />
                    </a>
                ))}
            </div>
            <p class="mt-3 text-sm text-t-primary/60">
                Latest shots, hosted on Flickr — no uploads here.
            </p>
        ) : (
            <p class="text-sm text-t-primary/60">
                I post photos on{" "}
                <a
                    href={FLICKR_PROFILE_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    Flickr
                </a>
                . View the latest shots there.
            </p>
        )
    }
</section>
