---
import BaseHead from "../components/BaseHead.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Weather from "../components/Weather.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
    title = SITE_TITLE,
    description = SITE_DESCRIPTION,
    active = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
        <link rel="preload" href="/profile-sprite.webp" as="image" />
        <script is:inline>
            (function () {
                var theme = localStorage.getItem("theme") || "dark";
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
    </head>
    <body class="bg-surface text-t-primary min-h-screen">
        <div class="max-w-2xl mx-auto px-6 py-16">
            <!-- Header -->
            <header class="mb-8">
                <div class="flex items-center justify-between gap-5">
                    <div>
                        <a href="/" class="text-4xl no-underline text-t-primary"
                            >Bhavya Karia</a
                        >
                        <p class="text-2xl mt-4 text-t-primary/50 font-medium">
                            Full Stack Engineer in<br />
                            Mumbai
                        </p>
                        <div class="mt-3 text-md flex flex-wrap gap-x-3">
                            <a
                                href="https://www.linkedin.com/in/bhavyakaria/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-t-accent transition-colors"
                                >linkedin</a
                            >
                            <span class="text-t-primary/25">&#8226;</span>
                            <a
                                href="mailto:contact.bhavyankaria@gmail.com"
                                class="text-t-accent transition-colors">email</a
                            >
                            <span class="text-t-primary/25">&#8226;</span>
                            <a
                                href="https://www.flickr.com/photos/114285742@N02/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-t-accent transition-colors"
                                >flickr</a
                            >
                            <span class="text-t-primary/25">&#8226;</span>
                            <a
                                href="https://topmate.io/bhavyakaria"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-t-accent transition-colors"
                                >topmate</a
                            >
                        </div>
                    </div>
                    <a
                        href="/"
                        data-mascot
                        class="inline-block rounded-full ring-2 ring-t-accent ring-offset-[6px] ring-offset-surface"
                        aria-label="Bhavya Karia — home"
                    >
                        <span
                            data-frame
                            role="img"
                            aria-label="Bhavya Karia avatar"
                            class="block w-40 h-40 rounded-full"
                            style="background-image: url(/profile-sprite.webp); background-size: 300% 300%; background-position: 50% 50%; background-repeat: no-repeat; background-color: #e8e6e3;"
                        ></span>
                    </a>
                </div>
                <nav class="mt-12 text-md">
                    <div class="flex flex-wrap justify-center gap-x-8 gap-y-1 items-center">
                        <a
                            href="/"
                            class={`hover:text-t-accent transition-colors${active === "home" ? " underline decoration-t-accent underline-offset-8 text-t-accent font-semibold" : " text-t-primary/60"}`}
                            >home</a
                        >
                        <a
                            href="/blog/"
                            class={`hover:text-t-accent transition-colors${active === "blog" ? " underline decoration-t-accent underline-offset-8 text-t-accent font-semibold" : " text-t-primary/60"}`}
                            >blog</a
                        >
                        <a
                            href="/projects"
                            class={`hover:text-t-accent transition-colors${active === "projects" ? " underline decoration-t-accent underline-offset-8 text-t-accent font-semibold" : " text-t-primary/60"}`}
                            >projects</a
                        >
                        <a
                            href="https://drive.google.com/file/d/1uZXjuOaq9yBQbSqIWppGzVVt5CN9n9no/view?usp=sharing"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-t-primary/60 hover:text-t-accent transition-colors"
                            >resume</a
                        >
                        <button
                            id="theme-toggle"
                            onclick="var h=document.documentElement;var c=h.getAttribute('data-theme');var n=c==='light'?'dark':'light';h.setAttribute('data-theme',n);localStorage.setItem('theme',n);this.textContent=n==='light'?'\u25D0':'\u25D1';"
                            class="text-t-primary/60 hover:text-t-accent transition-colors leading-none"
                            aria-label="Toggle theme">◑</button
                        >
                        <button
                            id="sound-toggle"
                            class="text-t-primary/60 hover:text-t-accent transition-colors leading-none inline-flex items-center justify-center"
                            aria-label="Mute sounds"
                            title="Mute sounds"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></button
                        >
                        <button
                            id="palette-trigger"
                            class="text-t-primary/60 hover:text-t-accent transition-colors"
                            aria-label="Open command palette"
                            title="Command palette (Ctrl/⌘ + K)">⌘K</button
                        >
                    </div>
                </nav>
                <script is:inline>
                    document.getElementById("theme-toggle").textContent =
                        document.documentElement.getAttribute("data-theme") ===
                        "light"
                            ? "\u25D0"
                            : "\u25D1";
                </script>
                <script is:inline>
                    (function () {
                        var host = document.querySelector("[data-mascot]");
                        if (!host) return;
                        var frame = host.querySelector("[data-frame]");
                        if (!frame) return;
                        var NEUTRAL = 4;
                        var ORDER = [5, 8, 7, 6, 3, 0, 1, 2];
                        var STEP = (Math.PI * 2) / ORDER.length;
                        var HYST = 0.12;
                        var DEAD = 70;
                        var set = function (i) {
                            frame.style.backgroundPosition =
                                (i % 3) * 50 +
                                "% " +
                                Math.floor(i / 3) * 50 +
                                "%";
                        };
                        var norm = function (a) {
                            return Math.atan2(Math.sin(a), Math.cos(a));
                        };
                        set(NEUTRAL);
                        if (
                            !window.matchMedia("(hover: hover) and (pointer: fine)")
                                .matches
                        )
                            return;
                        if (
                            window.matchMedia("(prefers-reduced-motion: reduce)")
                                .matches
                        )
                            return;
                        var current = -1;
                        var pos = null;
                        var scheduled = 0;
                        var update = function () {
                            scheduled = 0;
                            if (!pos) return;
                            var r = host.getBoundingClientRect();
                            var dx = pos.x - (r.left + r.width / 2);
                            var dy = pos.y - (r.top + r.height / 2);
                            if (Math.hypot(dx, dy) < DEAD) {
                                current = -1;
                                set(NEUTRAL);
                                return;
                            }
                            var ang = Math.atan2(dy, dx);
                            if (
                                current !== -1 &&
                                Math.abs(norm(ang - current * STEP)) <
                                    STEP / 2 + HYST
                            )
                                return;
                            current =
                                (Math.round(ang / STEP) + ORDER.length) %
                                ORDER.length;
                            set(ORDER[current]);
                        };
                        var kick = function () {
                            if (!scheduled)
                                scheduled = requestAnimationFrame(update);
                        };
                        window.addEventListener(
                            "pointermove",
                            function (e) {
                                pos = { x: e.clientX, y: e.clientY };
                                kick();
                            },
                            { passive: true }
                        );
                        window.addEventListener("scroll", kick, { passive: true });
                    })();
                </script>
            </header>

            <main>
                <slot />
            </main>

            <footer
                class="mt-24 pt-8 border-t border-b-color/15 text-sm text-t-primary/40 flex items-center justify-between gap-4"
            >
                Personal site of Bhavya Karia<Weather />
            </footer>
        </div>
        <CommandPalette />
        <script type="module" src="/ui-sound.js"></script>
    </body>
</html>
