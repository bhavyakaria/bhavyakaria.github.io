---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
    title = SITE_TITLE,
    description = SITE_DESCRIPTION,
    active = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead title={title} description={description} />
        <script is:inline>
            (function () {
                var theme = localStorage.getItem("theme") || "dark";
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
    </head>
    <body class="bg-surface text-t-primary min-h-screen">
        <div class="max-w-2xl mx-auto px-6 py-16">
            <!-- Header -->
            <header class="mb-8">
                <div class="flex items-center justify-between gap-5">
                    <div>
                        <a href="/" class="text-4xl no-underline text-t-primary"
                            >Bhavya Karia</a
                        >
                        <p class="text-2xl mt-4 text-t-primary/50 font-medium">
                            Full Stack Engineer in<br />
                            Mumbai
                        </p>
                        <div class="mt-3 text-md flex flex-wrap gap-x-3">
                            <a
                                href="https://www.linkedin.com/in/bhavyakaria/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-t-accent transition-colors"
                                >linkedin</a
                            >
                            <span class="text-t-primary/25">&#8226;</span>
                            <a
                                href="mailto:contact.bhavyankaria@gmail.com"
                                class="text-t-accent transition-colors">email</a
                            >
                            <span class="text-t-primary/25">&#8226;</span>
                            <a
                                href="https://www.flickr.com/photos/114285742@N02/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-t-accent transition-colors"
                                >flickr</a
                            >
                        </div>
                    </div>
                    <a
                        href="/"
                        class="inline-block rounded-full ring-2 ring-t-accent ring-offset-[6px] ring-offset-surface"
                    >
                        <img
                            src="/profile.jpg"
                            alt="Bhavya Karia"
                            class="w-40 h-40 rounded-full object-cover"
                        />
                    </a>
                </div>
                <nav class="mt-12 text-md">
                    <div class="flex flex-wrap justify-center gap-x-8 gap-y-1">
                        <a
                            href="/"
                            class={`text-t-primary/60 hover:text-t-accent transition-colors${active === "home" ? " underline decoration-t-accent underline-offset-4 text-t-accent" : ""}`}
                            >home</a
                        >
                        <a
                            href="/blog/"
                            class={`text-t-primary/60 hover:text-t-accent transition-colors${active === "blog" ? " underline decoration-t-accent underline-offset-4 text-t-accent" : ""}`}
                            >blog</a
                        >
                        <a
                            href="/projects"
                            class={`text-t-primary/60 hover:text-t-accent transition-colors${active === "projects" ? " underline decoration-t-accent underline-offset-4 text-t-accent" : ""}`}
                            >projects</a
                        >
                        <a
                            href="https://drive.google.com/file/d/1uZXjuOaq9yBQbSqIWppGzVVt5CN9n9no/view?usp=sharing"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-t-primary/60 hover:text-t-accent transition-colors"
                            >resume</a
                        >
                        <button
                            id="theme-toggle"
                            onclick="var h=document.documentElement;var c=h.getAttribute('data-theme');var n=c==='light'?'dark':'light';h.setAttribute('data-theme',n);localStorage.setItem('theme',n);this.textContent=n==='light'?'\u25D0':'\u25D1';"
                            class="text-t-primary/60 hover:text-t-accent transition-colors"
                            aria-label="Toggle theme">◑</button
                        >
                    </div>
                </nav>
                <script is:inline>
                    document.getElementById("theme-toggle").textContent =
                        document.documentElement.getAttribute("data-theme") ===
                        "light"
                            ? "\u25D0"
                            : "\u25D1";
                </script>
            </header>

            <main>
                <slot />
            </main>

            <footer
                class="mt-24 pt-8 border-t border-b-color/15 text-sm text-t-primary/40"
            >
                Personal site of Bhavya Karia
            </footer>
        </div>
    </body>
</html>
