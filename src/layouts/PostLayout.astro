---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {
  active?: string;
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], active = 'blog' } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
---

<BaseLayout title={title} description={description} image={heroImage} active={active}>
  <article>
    <h1 class="text-2xl font-semibold mb-2 text-t-accent">{title}</h1>
    <div class="text-sm text-t-primary/50 mb-6">
      {pubDate && <time>{displayDate}</time>}
      {updatedDate && <span> &middot; Updated {updatedDate}</span>}
    </div>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <a href={`/blog/tag/${tag}`} class="text-xs text-t-primary/50 border border-b-color/15 px-2 py-0.5 hover:text-t-accent transition-colors">
            {tag}
          </a>
        ))}
      </div>
    )}
    <hr />
    <div class="prose prose-base max-w-none mt-6">
      <slot />
    </div>
  </article>
</BaseLayout>
