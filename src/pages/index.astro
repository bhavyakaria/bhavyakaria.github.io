---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout active="home">
    <!-- Intro -->
    <section class="mb-8">
        <p class="text-t-primary leading-relaxed">
            Hey, I'm Bhavya Karia! Senior Full Stack Engineer at <a
                href="https://www.sardine.ai"
                class="underline text-t-accent"
                target="_blank"
                rel="noopener noreferrer">Sardine</a
            >, where I build tools to fight fraud in payments. Previously, I've
            worked at BrowserStack, Upwards Fintech, Vimana, and Myrsa Tech
            &mdash; across domains like fintech, IoT, and manufacturing.
        </p>
        <p class="text-t-primary leading-relaxed mt-3">
            In my free time, I enjoy giving back through open source, career
            counseling, and competitive programming.
        </p>
    </section>

    <!-- Open Source -->
    <section class="mb-12">
        <h2
            class="text-base font-semibold mb-4 pb-1 border-b border-b-color/15"
        >
            Open Source
        </h2>
        <ul class="space-y-3 text-sm text-t-primary">
            <li>
                <a
                    href="https://github.com/project-travel-mate/Travel-Mate/pulls?q=is%3Apr+is%3Aclosed+author%3Abhavyakaria"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    Fixing Bugs for Travel Mate &mdash; Android Application
                </a>
            </li>
            <li>
                <a
                    href="https://github.com/google/wikiloop-doublecheck/pulls?q=is:pr+is:closed+author:bhavyakaria"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    Wikiloop Battlefield (Google) &mdash; Fighting Vandalism on
                    Wikipedia
                </a>
            </li>
            <li>
                <a
                    href="https://github.com/labuladong/fucking-algorithm/pulls?q=is:pr+author:bhavyakaria+is:closed"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    Adding Algorithms in Kotlin
                </a>
            </li>
        </ul>
    </section>

    <!-- StackOverflow -->
    <section class="mb-12">
        <h2
            class="text-base font-semibold mb-4 pb-1 border-b border-b-color/15"
        >
            StackOverflow
        </h2>
        <ul class="space-y-3 text-sm text-t-primary">
            <li>
                <a
                    href="https://stackoverflow.com/a/59050236/4511489"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    How do I add a Fragment to an Activity with a
                    programmatically created content view
                </a>
            </li>
            <li>
                <a
                    href="https://stackoverflow.com/a/62607421/4511489"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    How do I escape curly braces for display on page when using
                    AngularJS?
                </a>
            </li>
            <li>
                <a
                    href="https://stackoverflow.com/a/66093068/4511489"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline text-t-accent"
                >
                    mongoose "Find" with multiple conditions
                </a>
            </li>
        </ul>
    </section>
</BaseLayout>
