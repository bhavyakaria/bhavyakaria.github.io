---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import Card from "../components/Card.astro";
console.log("sample");
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
    <div>
        <div class="text-3xl w-full font-bold my-10">Projects</div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <Card
            title="Quote Book"
            img="/post_img.webp"
            ,
            desc="An application for viewing and adding highlights from my kindle."
            ,
            url="https://github.com/bhavyakaria/quote-book"
            ,
            badge=""
            ,
            tags={["web app", "angular"]}
            ,
            target="_blank"
        />

        <Card
            title="Graphics Editor"
            img="/post_img.webp"
            ,
            desc="A graphics editor built for reduce manual masking efforts of employees."
            ,
            url="https://github.com/bhavyakaria/graphics-editor"
            ,
            badge=""
            ,
            tags={["web app", "angular", "canvas"]}
            target="_blank"
        />

        <Card
            title="Travel-Mate"
            img="/post_img.webp"
            ,
            desc="Trying to add meaningful contribution to an open source repository."
            ,
            url="https://github.com/project-travel-mate/Travel-Mate/pulls?q=is%3Apr+author%3Abhavyakaria+is%3Aclosed"
            ,
            badge=""
            ,
            tags={["open source", "android", "java"]}
            target="_blank"
        />

        <Card
            title="Korri"
            img="/post_img.webp"
            ,
            desc="Working on a project to make people's life easy while maintaining their finances."
            ,
            url="https://github.com/bhavyakaria/Korri"
            ,
            badge=""
            ,
            tags={["android", "kotlin", "jetpack compose"]}
            target="_blank"
        />

        <Card
            title="dedoop"
            img="/post_img.webp"
            ,
            desc="High‑performance duplicate file finder. Finds byte‑identical files by content (not filename) across one or two directories."
            ,
            url="https://github.com/bhavyakaria/dedoop"
            ,
            badge=""
            ,
            tags={["rust", "open source", "cli"]}
            target="_blank"
        />

        <Card
            title="filer"
            img="/post_img.webp"
            ,
            desc="Free, private PDF tools that run entirely in your browser. No file uploads, no server, no tracking."
            ,
            url="https://github.com/bhavyakaria/filer"
            ,
            badge=""
            ,
            tags={["nodejs", "open source", "javascript"]}
            target="_blank"
        />
    </div>
</BaseLayout>
