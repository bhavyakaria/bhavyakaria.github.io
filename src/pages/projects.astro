---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
    {
        title: "Quote Book",
        desc: "An application for viewing and adding highlights from my kindle.",
        github: "https://github.com/bhavyakaria/quote-book",
        tags: ["web app", "angular"],
    },
    {
        title: "Graphics Editor",
        desc: "A graphics editor built to reduce manual masking efforts of employees.",
        github: "https://github.com/bhavyakaria/graphics-editor",
        tags: ["web app", "angular", "canvas"],
    },
    {
        title: "Travel-Mate",
        desc: "Meaningful contributions to an open source travel companion app.",
        github: "https://github.com/project-travel-mate/Travel-Mate/pulls?q=is%3Apr+author%3Abhavyakaria+is%3Aclosed",
        tags: ["open source", "android", "java"],
    },
    {
        title: "Korri",
        desc: "A personal finance manager to make money tracking effortless.",
        github: "https://github.com/bhavyakaria/Korri",
        tags: ["android", "kotlin", "jetpack compose"],
    },
    {
        title: "dedoop",
        desc: "High-performance duplicate file finder. Finds byte-identical files across directories.",
        github: "https://github.com/bhavyakaria/dedoop",
        tags: ["rust", "open source", "cli"],
    },
    {
        title: "filer",
        desc: "Free, private PDF tools that run entirely in your browser. No uploads, no tracking.",
        github: "https://github.com/bhavyakaria/filer",
        website: "https://filer.bhavyakaria.workers.dev/",
        tags: ["nodejs", "open source", "javascript"],
    },
];
---

<BaseLayout title="Projects" active="projects">
    <ul class="space-y-8">
        {
            projects.map((p) => (
                <li>
                    <h2 class="text-base font-semibold inline">{p.title}</h2>
                    <span class="text-sm ml-3">
                        <a
                            href={p.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline text-t-accent hover:no-underline"
                        >
                            github
                        </a>
                        {p.website && (
                            <span>
                                <span class="text-t-primary/25">
                                    {" "}
                                    &middot;{" "}
                                </span>
                                <a
                                    href={p.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="underline text-t-accent hover:no-underline"
                                >
                                    website &nearr;
                                </a>
                            </span>
                        )}
                    </span>
                    <p class="text-sm text-t-primary mt-2 leading-relaxed">
                        {p.desc}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-2">
                        {p.tags.map((tag) => (
                            <span class="text-xs text-t-primary/50 border border-b-color/15 px-2 py-0.5">
                                {tag}
                            </span>
                        ))}
                    </div>
                </li>
            ))
        }
    </ul>
</BaseLayout>
